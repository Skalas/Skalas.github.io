---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b-[3px] border-[color:var(--accent-rule)] bg-[color:var(--header-bg)]">
  <nav
    aria-label="Primary"
    class="container-wide flex h-16 items-center justify-between"
  >
    <a
      href="/"
      class="inline-flex min-h-11 items-center font-display text-lg font-bold tracking-[-0.025em] no-underline text-[color:var(--header-text)] hover:text-[color:var(--accent-rule)]"
      aria-label={`${SITE.title} · home`}
    >
      {SITE.title}
    </a>

    <ul class="flex items-center gap-1 text-xs sm:gap-3 sm:text-sm">
      {
        NAV.map(({ href, label }) => {
          const normalized = href.replace(/\/$/, '') || '/';
          const isActive =
            normalized === '/'
              ? path === '/'
              : path === normalized || path.startsWith(`${normalized}/`);
          return (
            <li>
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center px-2.5 no-underline transition-colors duration-150 ease-out active:scale-[0.97]',
                  isActive
                    ? 'font-semibold text-[color:var(--header-text)]'
                    : 'text-[color:var(--header-muted)] hover:text-[color:var(--header-text)]',
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
