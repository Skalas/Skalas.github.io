---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import homeBg from '../assets/heroes/home-bg.jpg';
import { SITE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const [latestPost, ...archivePosts] = posts;
---

<BaseLayout
  title={undefined}
  description={SITE.description}
  image={homeBg.src}
  imageWidth={homeBg.width}
  imageHeight={homeBg.height}
  imageAlt="Miguel Escalante · Systems & Writing"
>
  <section class="container-wide pb-10 pt-12 md:pb-12 md:pt-16">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-[color:var(--text-muted)]">
      San Salvador &amp; Mexico City · Essays by Miguel Escalante
    </p>

    <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-[1.06] tracking-[-0.025em] text-[color:var(--text)] sm:text-5xl md:text-6xl">
      Models are the easy part. The job is the system around them.
    </h1>

    <p class="mt-5 max-w-[60ch] font-serif text-lg leading-relaxed text-[color:var(--text-muted)] md:text-xl">
      Field notes on applied mathematics, AI in production, and the human bottlenecks that decide whether software actually works.
    </p>

    <figure class="mt-8 md:mt-10">
      <Image
        src={homeBg}
        alt="Morning mist over the canals of Xochimilco"
        widths={[640, 960, 1280, 1600, 1900]}
        sizes="(max-width: 1280px) 100vw, 1280px"
        loading="eager"
        fetchpriority="high"
        class="aspect-[19/6] w-full rounded-[2px] border border-[color:var(--border)] object-cover"
      />
    </figure>
  </section>

  {latestPost && (
    <section class="container-wide border-t border-[color:var(--border)] py-12 md:py-16" aria-labelledby="latest-title">
      <div class="grid gap-6 md:grid-cols-[12rem_1fr]">
        <div>
          <h2 id="latest-title" class="font-display text-xl font-bold text-[color:var(--text)]">Latest essay</h2>
          <div class="mt-1 text-sm text-[color:var(--text-muted)] tabular-nums">
            <FormattedDate date={latestPost.data.date} />
          </div>
          {latestPost.data.category && (
            <div class="mt-2"><span class="category-pill">{latestPost.data.category}</span></div>
          )}
        </div>
        <a href={`/${latestPost.id}/`} class="group block no-underline">
          <h3 class="font-display text-3xl font-bold leading-[1.12] tracking-[-0.02em] text-[color:var(--text)] transition-colors duration-150 group-hover:text-[color:var(--link)] md:text-4xl">
            {latestPost.data.title}
          </h3>
          {latestPost.data.description && (
            <p class="mt-4 max-w-[60ch] font-serif text-xl leading-relaxed text-[color:var(--text-muted)]">
              {latestPost.data.description}
            </p>
          )}
          <span class="mt-4 inline-flex items-center gap-1.5 font-sans text-sm font-medium text-[color:var(--link)]">
            Read essay <span aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      </div>
    </section>
  )}

  <section class="container-wide border-t border-[color:var(--border)] py-12 md:py-20" aria-labelledby="archive-title">
    <header class="mb-10 flex items-baseline justify-between">
      <h2 id="archive-title" class="font-display text-2xl font-bold tracking-tight text-[color:var(--text)]">Archive</h2>
      <a
        href="/feed.xml"
        class="inline-flex min-h-11 items-center rounded border border-[color:var(--border)] px-3.5 py-1 font-mono text-xs no-underline text-[color:var(--text-muted)] transition-colors duration-150 hover:border-[color:var(--link)] hover:text-[color:var(--link)] active:scale-[0.97]"
      >
        RSS
      </a>
    </header>

    <ol class="space-y-12">
      {
        archivePosts.map((post, index) => (
          <li
            class="fade-up-item"
            style={`transition-delay: ${index * 60}ms`}
            data-animate
          >
            <article class="group grid gap-2 md:grid-cols-[12rem_1fr]">
              <div class="text-sm text-[color:var(--text-muted)] tabular-nums md:pt-2">
                <FormattedDate date={post.data.date} />
              </div>
              <div>
                <a href={`/${post.id}/`} class="no-underline">
                  <h3 class="font-display text-2xl font-bold leading-tight text-[color:var(--text)] transition-colors duration-150 group-hover:text-[color:var(--link)] md:text-3xl">
                    {post.data.title}
                    <span
                      aria-hidden="true"
                      class="ml-1.5 inline-block -translate-x-1 opacity-0 transition-[transform,opacity] duration-150 ease-out group-hover:translate-x-0 group-hover:opacity-100"
                    >→</span>
                  </h3>
                </a>
                {post.data.description && (
                  <p class="mt-3 max-w-[60ch] font-serif text-lg text-[color:var(--text-muted)]">
                    {post.data.description}
                  </p>
                )}
                {post.data.category && (
                  <p class="mt-3">
                    <span class="category-pill">{post.data.category}</span>
                  </p>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-animate]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
  );

  items.forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.style.transitionDuration = '0s';
      el.classList.add('is-visible');
      requestAnimationFrame(() => el.style.removeProperty('transition-duration'));
    } else {
      observer.observe(el);
    }
  });
</script>
