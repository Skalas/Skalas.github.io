---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import homeBg from '../assets/heroes/home-bg.jpg';
import { SITE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const systems = [
  {
    code: '01 · PUBLIC AI',
    scope: 'EL SALVADOR · 2024–PRESENT',
    name: 'DoctorSV · National Telemedicine',
    detail: 'AI triage, pre-consult symptom summaries, and chronic-disease monitoring across public clinics.',
    href: '/data-science-journey-part-2/',
  },
  {
    code: '02 · PHYSICAL OPS',
    scope: 'SAN SALVADOR · PRODUCTION',
    name: 'Aluxe & CNTRL · Operating Software',
    detail: 'Café POS and kitchen software driving thermal printers over raw TCP with zero local server in the shop.',
    href: '/about/',
  },
  {
    code: '03 · AGENT STACK',
    scope: 'LOCAL-FIRST · OPEN SOURCE',
    name: 'Shared Brain & Multi-Model Loops',
    detail: 'Local SQLite and append-only Markdown shared across independent coding, prose, and UI agents.',
    href: '/dont-build-a-second-brain/',
  },
];
---

<BaseLayout
  title={undefined}
  description={SITE.description}
  image={homeBg.src}
  imageWidth={homeBg.width}
  imageHeight={homeBg.height}
  imageAlt="Miguel Escalante · Systems & Writing"
>
  <section class="border-b border-[color:var(--border)] pb-14 pt-14 md:pb-20 md:pt-24">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-[1fr_26rem] lg:items-start">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-[color:var(--text-muted)]">
            {SITE.author.location} · MATHEMATICIAN &amp; AI LEAD
          </p>

          <h1 class="mt-5 max-w-3xl font-serif text-4xl font-semibold leading-[1.06] tracking-[-0.025em] text-[color:var(--text)] sm:text-5xl md:text-6xl">
            Models are the easy part. The job is the system around them.
          </h1>

          <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed text-[color:var(--text-muted)] md:text-xl">
            I'm {SITE.author.name}. For fifteen years I've built mathematical models and production software across police dispatch, earthquake response, unicorn pricing, and national healthcare. Projects rarely fail over two points of AUC. They fail when you ignore the human bottleneck downstream.
          </p>
        </div>

        <aside aria-label="Systems in production" class="border border-[color:var(--border)] bg-[color:var(--surface)]">
          <div class="flex items-center justify-between border-b border-[color:var(--border)] px-5 py-3">
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-[color:var(--text-muted)]">
              Systems Ledger
            </span>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[color:var(--text-muted)] tabular-nums">
              3 ACTIVE
            </span>
          </div>
          <ol class="divide-y divide-[color:var(--border)]">
            {systems.map((sys) => (
              <li>
                <a
                  href={sys.href}
                  class="group block px-5 py-4 no-underline transition-colors duration-150 ease-out hover:bg-[color:var(--bg)] active:scale-[0.99]"
                >
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
                    <span class="shrink-0 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-[color:var(--link)] tabular-nums">
                      {sys.code}
                    </span>
                    <span class="shrink-0 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-[color:var(--text-muted)] tabular-nums">
                      {sys.scope}
                    </span>
                  </div>
                  <h2 class="mt-1.5 flex items-baseline justify-between font-sans text-sm font-semibold tracking-tight text-[color:var(--text)] transition-colors duration-150 group-hover:text-[color:var(--link)]">
                    <span>{sys.name}</span>
                    <span aria-hidden="true" class="font-mono text-xs text-[color:var(--text-muted)] transition-transform duration-150 ease-out group-hover:translate-x-0.5 group-hover:text-[color:var(--link)]">→</span>
                  </h2>
                  <p class="mt-1 font-serif text-sm leading-snug text-[color:var(--text-muted)]">
                    {sys.detail}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <section class="container-wide py-16 md:py-24">
    <header class="mb-12 flex items-baseline justify-between border-b border-[color:var(--border)] pb-6">
      <h2 class="font-mono text-xs uppercase tracking-[0.25em] text-[color:var(--text-muted)]">
        Field Notes &amp; Essays
      </h2>
      <a
        href="/feed.xml"
        class="inline-flex min-h-11 items-center rounded border border-[color:var(--border)] px-3.5 py-1 font-mono text-xs no-underline text-[color:var(--text-muted)] transition-colors duration-150 hover:border-[color:var(--link)] hover:text-[color:var(--link)] active:scale-[0.97]"
      >
        RSS
      </a>
    </header>

    <ol class="space-y-12">
      {
        posts.map((post, index) => (
          <li
            class="fade-up-item"
            style={`transition-delay: ${index * 60}ms`}
            data-animate
          >
            <article class="group grid gap-2 md:grid-cols-[10rem_1fr]">
              <div class="font-mono text-xs uppercase tracking-[0.16em] text-[color:var(--text-muted)] tabular-nums md:pt-2">
                <FormattedDate date={post.data.date} />
              </div>
              <div>
                <a href={`/${post.id}/`} class="no-underline">
                  <h3 class="font-serif text-2xl font-semibold leading-tight text-[color:var(--text)] transition-colors duration-150 group-hover:text-[color:var(--link)] md:text-3xl">
                    {post.data.title}
                    <span
                      aria-hidden="true"
                      class="ml-1.5 inline-block -translate-x-1 opacity-0 transition-[transform,opacity] duration-150 ease-out group-hover:translate-x-0 group-hover:opacity-100"
                    >→</span>
                  </h3>
                </a>
                {post.data.description && (
                  <p class="mt-3 font-serif text-lg text-[color:var(--text-muted)]">
                    {post.data.description}
                  </p>
                )}
                {post.data.category && (
                  <p class="mt-3">
                    <span class="category-pill">{post.data.category}</span>
                  </p>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-animate]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
  );

  items.forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.style.transitionDuration = '0s';
      el.classList.add('is-visible');
      requestAnimationFrame(() => el.style.removeProperty('transition-duration'));
    } else {
      observer.observe(el);
    }
  });
</script>
