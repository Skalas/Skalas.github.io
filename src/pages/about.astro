---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutBg from '../assets/heroes/about-bg.jpg';

const roles = [
  {
    period: '2024–Present',
    title: 'AI Lead Consultant',
    org: 'Government of El Salvador',
    summary:
      'AI strategy and clinical systems for <strong>DoctorSV</strong>, national telemedicine: triage, pre-consult summaries, chronic-disease monitoring. Began on USAID and EU-funded 5G coverage work.',
  },
  {
    period: '2022–2024',
    title: 'Staff Software Engineer',
    org: 'Kavak',
    summary:
      'Led the data engineering half of the pricing team after Kavak acquired OPI Analytics, owning the pipelines and cloud infrastructure behind vehicle pricing models in every market.',
  },
  {
    period: '2018–2022',
    title: 'Software Designer / AI Lead',
    org: 'Globant',
    summary:
      'Led the Mexico AI team across medical imaging, legal NLP, and anomaly detection. Consulting taught me to diagnose an organization’s real constraints before learning its politics.',
  },
  {
    period: '2016–2018',
    title: 'Data Science Manager',
    org: 'Cultura Colectiva',
    summary:
      'Built the data science and BI team from scratch. In September 2017 we paused normal work to build <strong>Verificado19s</strong>, a real-time civic verification platform for the Mexico City earthquake.',
  },
  {
    period: '2016',
    title: 'Data Science Lead · Data Lab',
    org: 'Presidency of Mexico · Open Data Initiative',
    summary:
      'Centralized technical team inside the federal government: find the bottleneck, build the analytical pipeline, and ship cloud infrastructure across multiple ministries.',
  },
  {
    period: '2015–2016',
    title: 'Data Scientist / Data Engineer',
    org: 'Globant · OPI Analytics',
    summary:
      'Discrete math optimization for Globant textile distribution: physical constraints, real money, no neural nets. At OPI, full-stack startup engineering and cloud ops from zero.',
  },
  {
    period: '2010–2015',
    title: 'Data Analyst',
    org: 'Center for Emergency Attention and Citizen Protection (C4), Mexico City',
    summary:
      'Crime prediction and officer evaluations in Excel macros and Matlab. The math was easy; the job was a dispatch number a commander off an 18-hour shift could act on at 6:00 AM.',
  },
];

const courses = [
  'NoSQL for Data Science (M.Sc.)',
  'Introduction to Programming for Data Science (M.Sc.)',
  'Applied Analysis in Computational Mathematics',
];

const publications = [
  {
    year: '2019',
    citation: 'Esquinca, Escalante et al. ',
    title: 'Recomendaciones para Sociedad Civil',
    venue: 'Google Play Store.',
  },
  {
    year: '2016',
    citation: 'Martinez, Escalante, Beguerisse-Díaz et al. ',
    title: 'Understanding Human Behavior in Urban Spaces',
    venue: 'IJWSR.',
  },
  {
    year: '2013',
    citation: 'Prieto, Escalante et al. ',
    title: 'Análisis Criminal y Uso de Cámaras de Seguridad en la CDMX',
    venue: 'Buenas Prácticas para el Análisis Delictual en América Latina.',
  },
];
---

<BaseLayout
  title="About"
  description="Miguel Escalante · Mathematician, AI Lead, and engineer based in San Salvador."
  image={aboutBg.src}
  imageWidth={aboutBg.width}
  imageHeight={aboutBg.height}
  imageAlt="Miguel Escalante · About"
>
  <div class="container-wide pb-16 pt-14 md:pt-20">

    <header class="mb-10 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-[color:var(--text-muted)]">
        ABOUT · MIGUEL ESCALANTE
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-[1.1] tracking-[-0.02em] text-[color:var(--text)] md:text-5xl">
        What happens after the model runs.
      </h1>

      <p class="mt-6 max-w-[60ch] font-serif text-xl leading-relaxed text-[color:var(--text)]">
        Projects rarely fail over two points of AUC. They fail when the human bottleneck downstream gets ignored. I learned that building crime prediction models for the Mexico City police, and it held through federal open data, earthquake response, pricing pipelines, and national healthcare.
      </p>

      <p class="mt-4 max-w-[60ch] font-serif text-lg leading-relaxed text-[color:var(--text-muted)]">
        Today I lead AI strategy and clinical AI systems for the Government of El Salvador. I studied Applied Mathematics (B.Sc.) and Data Science (M.Sc.) at ITAM, where I taught graduate courses for four years while working full-time. <a href="/data-science-journey-2024/">Part 1</a> and <a href="/data-science-journey-part-2/">Part 2</a> of the career notes cover the longer version.
      </p>
    </header>

    <figure class="mb-14">
      <Image
        src={aboutBg}
        alt="A wooden pier with a thatched palapa at sunset"
        widths={[640, 960, 1280, 1600, 1900]}
        sizes="(max-width: 1280px) 100vw, 1280px"
        class="aspect-[19/6] w-full rounded-[2px] border border-[color:var(--border)] object-cover"
      />
    </figure>

    <section
      class="grid gap-8 border-t border-[color:var(--border)] pt-12 md:grid-cols-[14rem_1fr] lg:grid-cols-[16rem_1fr]"
      aria-labelledby="career-title"
    >
      <h2 id="career-title" class="font-display text-2xl font-bold tracking-tight text-[color:var(--text)]">
        Career &amp; systems
      </h2>

      <ol class="divide-y divide-[color:var(--border)]">
        {roles.map((role) => (
          <li class="grid gap-2 py-6 first:pt-0 sm:grid-cols-[9rem_1fr]">
            <div class="text-sm text-[color:var(--text-muted)] tabular-nums sm:pt-1">{role.period}</div>
            <div>
              <h3 class="font-display text-xl font-bold text-[color:var(--text)]">{role.title}</h3>
              <div class="mt-0.5 font-sans text-sm font-medium text-[color:var(--link)]">{role.org}</div>
              <p class="mt-2 max-w-[60ch] font-serif text-base leading-relaxed text-[color:var(--text-muted)]" set:html={role.summary} />
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="mt-12 grid gap-12 border-t border-[color:var(--border)] pt-12 md:grid-cols-2">
      <section aria-labelledby="teaching-title">
        <h2 id="teaching-title" class="font-display text-2xl font-bold tracking-tight text-[color:var(--text)]">
          Teaching
        </h2>
        <p class="mt-4 text-sm text-[color:var(--text-muted)] tabular-nums">ITAM, 2020–2024</p>
        <ul class="mt-3 space-y-1 font-serif text-base text-[color:var(--text-muted)]">
          {courses.map((course) => <li>{course}</li>)}
        </ul>
      </section>

      <section aria-labelledby="publications-title">
        <h2 id="publications-title" class="font-display text-2xl font-bold tracking-tight text-[color:var(--text)]">
          Selected publications
        </h2>
        <ul class="mt-4 space-y-4">
          {publications.map(({ year, citation, title, venue }) => (
            <li class="grid grid-cols-[3.5rem_1fr] gap-4 font-serif text-base">
              <span class="pt-0.5 text-sm text-[color:var(--text-muted)] tabular-nums">{year}</span>
              <span class="text-[color:var(--text-muted)]">
                {citation}<em class="text-[color:var(--text)]">{title}</em>. {venue}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="mt-12 max-w-3xl border-t border-[color:var(--border)] pt-12">
      <p class="max-w-[60ch] font-serif text-base leading-relaxed text-[color:var(--text-muted)]">
        San Salvador now, Mexico City before that. I also run a specialty coffee shop (<strong class="font-medium text-[color:var(--text)]">Aluxe</strong>) and build its operating software (<strong class="font-medium text-[color:var(--text)]">CNTRL</strong>). If you are working on a problem where the model works on paper but the organization or operation is stuck, reach me by <a href="mailto:escalas5@gmail.com">email</a>.
      </p>
    </section>

  </div>
</BaseLayout>
