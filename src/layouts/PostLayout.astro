---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  author?: string;
  category?: string;
  tags?: string[];
  hero?: ImageMetadata;
  heroAlt?: string;
  image?: string;
  imageAlt?: string;
  mathjax?: boolean;
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  date,
  updated,
  author = SITE.author.name,
  category,
  tags = [],
  hero,
  heroAlt,
  image,
  imageAlt,
  mathjax,
  prev,
  next,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt ?? heroAlt ?? title}
  imageWidth={hero?.width}
  imageHeight={hero?.height}
  type="article"
  publishedAt={date}
  updatedAt={updated}
  tags={tags}
  section={category}
  mathjax={mathjax}
>
  <header class="container-wide pb-8 pt-12 md:pb-12 md:pt-16">
    <div class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--text-muted)] tabular-nums">
        {category && <span class="category-pill">{category}</span>}
        <FormattedDate date={date} />
        {updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>Updated <FormattedDate date={updated} /></span>
          </>
        )}
      </div>

      <h1 class="mt-4 font-display text-4xl font-bold leading-[1.08] tracking-[-0.025em] text-[color:var(--text)] sm:text-5xl md:text-6xl">
        {title}
      </h1>

      {description && (
        <p class="mt-5 max-w-[60ch] font-serif text-xl leading-relaxed text-[color:var(--text-muted)]">
          {description}
        </p>
      )}
    </div>

    {hero && (
      <figure class="mt-8 md:mt-10">
        <Image
          src={hero}
          alt={heroAlt ?? title}
          widths={[640, 960, 1280, 1600, 1900]}
          sizes="(max-width: 1280px) 100vw, 1280px"
          loading="eager"
          fetchpriority="high"
          class="aspect-[19/6] w-full rounded-[2px] border border-[color:var(--border)] object-cover"
        />
      </figure>
    )}
  </header>

  <article class="container-prose border-t border-[color:var(--border)] py-12 md:py-16">
    <div
      class="prose prose-lg max-w-none prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-a:text-[color:var(--link)] prose-code:rounded prose-code:bg-[color:var(--surface)] prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.9em] prose-code:before:content-none prose-code:after:content-none dark:prose-invert"
    >
      <slot />
    </div>

    {tags.length > 0 && (
      <ul class="mt-12 flex flex-wrap gap-2 font-mono text-xs" aria-label="Tags">
        {tags.map((t) => (
          <li class="rounded-[2px] border border-[color:var(--border)] bg-[color:var(--surface)] px-2.5 py-1 text-[color:var(--text-muted)]">
            #{t}
          </li>
        ))}
      </ul>
    )}
  </article>

  {(prev || next) && (
    <nav
      aria-label="Post navigation"
      class="container-prose border-t border-[color:var(--border)] py-8"
    >
      <ul class="flex flex-col justify-between gap-4 sm:flex-row">
        {prev && (
          <li class="flex-1">
            <a href={`/${prev.slug}/`} class="block no-underline group">
              <span class="block font-mono text-xs uppercase tracking-[0.2em] text-[color:var(--text-muted)]">
                Previous
              </span>
              <span class="mt-1 block font-display text-lg font-bold transition-colors duration-200 group-hover:text-[color:var(--link)]">
                <span aria-hidden="true" class="mr-1 inline-block translate-x-0 opacity-0 transition-[transform,opacity] duration-200 ease-out group-hover:-translate-x-1 group-hover:opacity-100">←</span>{prev.title}
              </span>
            </a>
          </li>
        )}
        {next && (
          <li class="flex-1 sm:text-right">
            <a href={`/${next.slug}/`} class="block no-underline group">
              <span class="block font-mono text-xs uppercase tracking-[0.2em] text-[color:var(--text-muted)]">
                Next
              </span>
              <span class="mt-1 block font-display text-lg font-bold transition-colors duration-200 group-hover:text-[color:var(--link)]">
                {next.title}<span aria-hidden="true" class="ml-1 inline-block -translate-x-1 opacity-0 transition-[transform,opacity] duration-200 ease-out group-hover:translate-x-0 group-hover:opacity-100">→</span>
              </span>
            </a>
          </li>
        )}
      </ul>
    </nav>
  )}
</BaseLayout>
